# RentPro Backend Environment Configuration Template
PORT=4000

# Database Configuration (MongoDB)
# Local MongoDB: mongodb://localhost:27017/rentpro
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/rentpro?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/rentpro

# Authentication (Optional)
AUTH_ENABLED=false
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=
JWT_SECRET=rentpro-local-dev-jwt-secret-minimum-32-chars-long

# Optional fallback data file path (defaults to backend/data.json)
# RENTPRO_DATA_FILE=
